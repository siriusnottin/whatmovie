# Application Configuration
APP_NAME="Whaat Movie"
APP_URL="${APP_URL:-http://localhost:8080}"
APP_PORT=8080

APP_LOCALE="en"
APP_TIMEZONE="Europe/Paris"

# Logging Configuration
APP_ENV="production"
APP_DEBUG=false

# Database
DB_CONNECTION="mysql"
DB_HOST="whatmovie-db-1"
DB_PORT=3306

DB_ROOT_PASSWORD="root"

DB_NAME="whatmovie"
DB_USERNAME="whatmovie"
DB_PASSWORD="password"

DB_CHARSET="utf8mb4"
DB_COLLATION="utf8mb4_unicode_ci"
# Prefix for all database table names to avoid naming conflicts
DB_PREFIX="wh_"
